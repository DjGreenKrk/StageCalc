<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (targetSdk >= 28) blocks plain HTTP by default. StageCalc's
  PocketBase backend (ADR-017) is deliberately LAN-only, unauthenticated
  transport, plain http:// - so this allows cleartext traffic to that one
  host instead of broadly disabling the OS protection. Update the domain
  here if `PocketBaseClientProvider`'s hardcoded address ever changes.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.113</domain>
    </domain-config>
</network-security-config>
